# Where x402 payments land. Until this is set, /api/analyze runs free and
# unprotected — the service will not pretend to charge.
X402_PAY_TO=

# CAIP-2 network id. eip155:84532 = Base Sepolia (testing),
# eip155:8453 = Base mainnet. PayBox pays from a plain EOA.
X402_NETWORK=eip155:84532

# Price per call, in USD. The backslash matters: an unescaped $0 is read as a
# variable reference in .env files and silently becomes ".02", which x402
# rejects. In Vercel's dashboard, enter it as $0.02 with no backslash.
X402_PRICE=\$0.02

# x402 facilitator. The public one is fine for testnet.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Public origin, used to build card links. Set this on Vercel.
NEXT_PUBLIC_BASE_URL=

# Indexer key for reading transaction history. PayBox returns balances only,
# so without this Piggy cannot see habits over time (DCA, raiding savings) and
# will report them as unavailable rather than guessing.
HELIUS_API_KEY=
